<Window x:Class="Sightquill.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Sightquill" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sightquill" Icon="Assets/Sightquill.ico" Width="1320" Height="860" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterScreen" Background="{StaticResource BaseBrush}" WindowStyle="None" Foreground="{StaticResource TextBrush}">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10"/></shell:WindowChrome.WindowChrome>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Border BorderBrush="#3D4B5D" BorderThickness="1" MinWidth="1060" MinHeight="740" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="#1B2330" MouseLeftButtonDown="DragHeader"><Grid Margin="24,0,14,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" Background="#2E475C" CornerRadius="12" Margin="0,0,12,0"><Grid><Ellipse Width="20" Height="20" Stroke="#80D8F7" StrokeThickness="1.5"/><Path Data="M21,6 L21,16 M21,26 L21,36 M6,21 L16,21 M26,21 L36,21" Stroke="#80D8F7" StrokeThickness="1.5"/></Grid></Border>
        <StackPanel><TextBlock Text="Sightquill" FontSize="25" FontWeight="SemiBold" FontFamily="Bahnschrift"/><TextBlock Text="Your crosshair. Your precision." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="#263443" CornerRadius="16" Padding="12,7" VerticalAlignment="Center" Margin="0,0,24,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#93A4B6" Margin="0,0,7,0"/><TextBlock x:Name="HeaderStatus" Text="Crosshair off" FontSize="12"/></StackPanel></Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Click="ShowHelp" Style="{StaticResource WindowButton}" ToolTip="Quick start guide" AutomationProperties.Name="Help"><Grid Width="18" Height="18"><Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/><TextBlock Text="?" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
        <Button Click="MinimizeWindow" Style="{StaticResource WindowButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 1,8 L 15,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
        <Button x:Name="MaximizeButton" Click="MaximizeWindow" Style="{StaticResource WindowButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path x:Name="MaximizeGlyph" Data="M 1,1 L 13,1 13,13 1,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
        <Button Click="CloseWindow" Tag="Close" Style="{StaticResource WindowButton}" ToolTip="Exit and disable crosshair" AutomationProperties.Name="Exit"><Path Data="M 1,1 L 13,13 M 13,1 L 1,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/></Button>
      </StackPanel>
    </Grid></Border>
    <Grid Grid.Row="1" Margin="22,22,22,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="288"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,17"><TextBlock Text="Crosshairs" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="CatalogCount" Text="24 presets" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,10"><TextBox x:Name="SearchBox" TextChanged="FilterChanged" ToolTip="Search crosshairs by name" AutomationProperties.Name="Search crosshairs"/><TextBlock Text="Search presets…" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryChanged" AutomationProperties.Name="Crosshair family"/>
          <Button Grid.Column="1" x:Name="FavoritesButton" Content="☆" Click="ToggleFavorites" Margin="8,0,0,0" Width="40" Padding="0" FontSize="21" ToolTip="Show favorites" AutomationProperties.Name="Filter favorites"/>
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel><UniformGrid x:Name="PresetGrid" Columns="3"/><TextBlock x:Name="EmptyLibrary" Text="No crosshairs found.&#10;Try another search or save favorites with ☆." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="12,24" Visibility="Collapsed"/></StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="4" Text="Start with a preset.&#10;Make every detail your own." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,16,0,0" LineHeight="19"/>
      </Grid>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,17"><TextBlock Text="Studio" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Live preview" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/></DockPanel>
        <Border Grid.Row="1" Background="#263343" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" MinHeight="150">
          <Grid ClipToBounds="True">
            <local:RangeBackdrop x:Name="Backdrop"/>
            <local:ReticleView x:Name="Preview" PhysicalPixels="True" IsHitTestVisible="False"/>
            <StackPanel VerticalAlignment="Top" Margin="20"><TextBlock x:Name="PresetTitle" Text="Pinpoint" FontSize="24" FontFamily="Bahnschrift"/><TextBlock x:Name="PreviewMetrics" Foreground="#C3D4E5" FontSize="12" Margin="0,5,0,0"/></StackPanel>
            <Border VerticalAlignment="Bottom" Background="#DD182330" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Actual size" Foreground="#BDCDDC" FontSize="11" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Range" Tag="0" Click="ChangeBackdrop" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="11"/><Button Content="Slate" Tag="1" Click="ChangeBackdrop" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="11"/><Button Content="Light" Tag="2" Click="ChangeBackdrop" Style="{StaticResource QuietButton}" Padding="7,4" FontSize="11"/></StackPanel>
            </Grid></Border>
          </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,14,0,0"><StackPanel>
          <DockPanel Margin="0,0,0,10"><TextBlock Text="Game &amp; display" FontWeight="SemiBold"/><Button Content="Recenter" Click="Recenter" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" FontSize="11" Padding="6,0"/></DockPanel>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="GameModeBox" SelectionChanged="GameModeChanged" AutomationProperties.Name="Game mode"><ComboBoxItem Content="Universal"/><ComboBoxItem Content="How to Fish"/></ComboBox>
            <Button x:Name="IntegrationButton" Grid.Column="1" Content="Set up…" Click="ManageIntegration" Margin="8,0,0,0" Padding="9,5" ToolTip="Install or remove the optional How to Fish companion"/>
          </Grid>
          <TextBlock x:Name="TrackingText" Text="Screen center" FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <ComboBox x:Name="MonitorBox" SelectionChanged="MonitorChanged" DisplayMemberPath="Label" AutomationProperties.Name="Crosshair display"/>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="OffsetXBox" Grid.Column="1" Text="0" TextChanged="OffsetChanged" AutomationProperties.Name="Horizontal offset in pixels" ToolTip="Horizontal offset, from −2000 to 2000 pixels" Padding="8,5"/>
            <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="OffsetYBox" Grid.Column="4" Text="0" TextChanged="OffsetChanged" AutomationProperties.Name="Vertical offset in pixels" ToolTip="Vertical offset, from −2000 to 2000 pixels" Padding="8,5"/>
          </Grid>
        </StackPanel></Border>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,14,0,0"><StackPanel>
          <TextBlock Text="My profiles" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProfileNameBox" Text="My crosshair" MaxLength="48" AutomationProperties.Name="Profile name"/><Button Grid.Column="1" Content="Save" Click="SaveProfile" Margin="8,0,0,0" Padding="10,6"/></Grid>
          <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name" SelectionChanged="ProfileSelected" AutomationProperties.Name="Saved profiles"/><Button x:Name="DeleteProfileButton" Grid.Column="1" Content="×" Click="DeleteProfile" Margin="8,0,0,0" Padding="10,4" ToolTip="Delete selected profile" AutomationProperties.Name="Delete profile"/></Grid>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="ImportButton" Content="Import crosshair" Click="ImportProfile" Height="34" Padding="8,5" FontSize="12" ToolTip="Import transparent PNG, Sightquill JSON, or Valorant / CS:GO / CS2 codes"/>
            <Button x:Name="ExportButton" Grid.Column="2" Content="Export crosshair" Click="ExportProfile" Height="34" Padding="8,5" FontSize="12" ToolTip="Export a complete Sightquill JSON profile or a transparent PNG"/>
          </Grid>
        </StackPanel></Border>
      </Grid>
      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18"><TextBlock Text="Customize" FontSize="19" FontWeight="SemiBold"/><Button Content="↺" Click="ResetPreset" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="5,0" FontSize="20" ToolTip="Reset preset" AutomationProperties.Name="Reset preset"/></DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
          <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <UniformGrid x:Name="SwatchGrid" Columns="7" Margin="0,0,0,10"/>
          <TextBox x:Name="ColorBox" Text="#80D8F7" MaxLength="7" TextChanged="ColorChanged" AutomationProperties.Name="Hex color" ToolTip="Hex color, for example #80D8F7" Margin="0,0,0,20"/>
          <Expander x:Name="ColorWheelExpander" Header="Color wheel" Foreground="{StaticResource TextBrush}" Margin="0,-10,0,16"><local:ColorWheel x:Name="Wheel"/></Expander>
          <DockPanel><TextBlock Text="Size"/><TextBlock x:Name="SizeValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel>
          <Slider x:Name="SizeSlider" Minimum="4" Maximum="160" Value="28" ValueChanged="SettingsChanged" AutomationProperties.Name="Size"/>
          <DockPanel><TextBlock Text="Thickness"/><TextBlock x:Name="ThicknessValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel>
          <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="16" Value="2" ValueChanged="SettingsChanged" AutomationProperties.Name="Thickness"/>
          <DockPanel><TextBlock Text="Gap"/><TextBlock x:Name="GapValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel>
          <Slider x:Name="GapSlider" Minimum="0" Maximum="40" Value="5" ValueChanged="SettingsChanged" AutomationProperties.Name="Gap"/>
          <DockPanel><TextBlock Text="Opacity"/><TextBlock x:Name="OpacityValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel>
          <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" ValueChanged="SettingsChanged" AutomationProperties.Name="Opacity"/>
          <DockPanel><TextBlock Text="Rotation"/><TextBlock x:Name="RotationValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"/></DockPanel>
          <Slider x:Name="RotationSlider" Minimum="0" Maximum="360" Value="0" ValueChanged="SettingsChanged" AutomationProperties.Name="Rotation"/>
          <CheckBox x:Name="CenterDotBox" Content="Center dot" Checked="OptionChanged" Unchecked="OptionChanged"/>
          <CheckBox x:Name="OutlineBox" Content="Dark outline" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged"/>
          <CheckBox x:Name="ResolutionBox" Content="Scale with resolution" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" ToolTip="Keep the same proportions: 1× at 1080p, 2× at 4K. Turn off for a fixed pixel size."/>
          <CheckBox x:Name="DynamicBox" Content="Dynamic crosshair" Checked="DynamicChanged" Unchecked="DynamicChanged" ToolTip="Simulate spread using movement keys and the left mouse button in How to Fish, Valorant or Counter-Strike."/>
          <StackPanel x:Name="DynamicControls" Visibility="Collapsed">
            <ComboBox x:Name="MovementKeysBox" SelectionChanged="DynamicChanged" AutomationProperties.Name="Movement keys"><ComboBoxItem Content="ZQSD (AZERTY)"/><ComboBoxItem Content="WASD (QWERTY)"/></ComboBox>
            <TextBlock Text="Movement spread" FontSize="11" Margin="0,10,0,0"/>
            <Slider x:Name="MoveSpreadSlider" Minimum="0" Maximum="24" Value="8" ValueChanged="DynamicChanged" AutomationProperties.Name="Movement spread"/>
            <TextBlock Text="Firing spread" FontSize="11"/>
            <Slider x:Name="FireSpreadSlider" Minimum="0" Maximum="24" Value="6" ValueChanged="DynamicChanged" AutomationProperties.Name="Firing spread"/>
            <Button Content="Preview animation" Click="PreviewAnimation" Padding="8,6" Margin="0,0,0,8"/>
            <TextBlock Text="Valorant codes use per-layer multipliers and firing fade. Input-based simulation, not weapon accuracy. Active in How to Fish, Valorant and CS:GO / CS2." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
          </StackPanel>
          <TextBlock Text="A fine outline keeps the crosshair visible against bright scenes." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,16" LineHeight="17"/>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,16"/>
          <Button x:Name="ToggleButton" Content="Enable crosshair" Click="ToggleOverlay" Style="{StaticResource AccentButton}" Padding="10,14" FontSize="15" AutomationProperties.Name="Toggle crosshair"/>
          <TextBlock x:Name="HotkeyLabel" Text="Ctrl + Alt + X  anytime" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
          <Button Content="Minimize to tray" Click="HideToTray" Style="{StaticResource QuietButton}" FontSize="11" Padding="0,12,0,0"/>
        </StackPanel>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="2" Background="#141B25" Padding="24,0"><DockPanel LastChildFill="True"><TextBlock Text="Sightquill 0.6" DockPanel.Dock="Right" Foreground="#8E9FB2" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0"/><TextBlock x:Name="StatusText" Text="Ready. Use windowed or borderless fullscreen in your game." Foreground="#AFBED0" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid></Border></Viewbox>
</Window>
