<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Sightquill.ico</ApplicationIcon>
    <Version>0.6.0</Version>
    <Product>Sightquill</Product>
    <Description>Your crosshair, your precision.</Description>
    <Authors>Sightquill</Authors>
    <!-- WPF owns the process; Forms is used only for screens and tray. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Sightquill.Core/Sightquill.Core.csproj" /><Resource Include="Assets/Sightquill.ico" /></ItemGroup>
</Project>
